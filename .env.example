# Copy to .env for local development (read by dotenvy). All settings: crates/api/src/config.rs
BIND_ADDR=127.0.0.1:3000
DATABASE_URL=sqlite://nullbox.db
# Build against the .sqlx cache: with DATABASE_URL alone, compiling fails until nullbox.db exists.
SQLX_OFFLINE=true
# Comma-separated. The web app runs on a different origin, like a Tauri webview would.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Where the web app lives; secret access links point here.
PUBLIC_WEB_URL=http://localhost:5173
# Unlocks GET /api/admin/export (header X-Admin-Token). No default: unset = export off (403).
# Set a long random value of your own, e.g. openssl rand -base64 48
# ADMIN_TOKEN=
# Bearer token for the MCP server at /mcp (AI agents). Unset: /mcp answers 401. e.g. openssl rand -hex 32
# MCP_TOKEN=
RUST_LOG=info,tower_http=debug
# "json" for one JSON object per log line (with trace_id/span_id). Unset: human-readable.
# LOG_FORMAT=json
# Payments (Stripe Checkout, test mode). Unset STRIPE_SECRET_KEY = payments off, app still starts.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# Optional: STRIPE_PRICE_ID (existing Price), or an inline price from these (defaults shown):
# STRIPE_AMOUNT=500
# STRIPE_CURRENCY=usd
# STRIPE_PRODUCT_NAME=Nullbox Pro
# Login (#14): when set, worker sign-up needs this invite code. Unset: anyone can sign up.
# SIGNUP_INVITE_CODE=
