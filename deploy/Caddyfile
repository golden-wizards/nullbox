{$SITE_ADDRESS:team-06.fasthacks.cloud} {
	encode zstd gzip

	handle /metrics {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# MCP server for AI agents (Authorization: Bearer $MCP_TOKEN)
	handle /mcp {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
