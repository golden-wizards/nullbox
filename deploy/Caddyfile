{$SITE_ADDRESS:team-06.fasthacks.cloud} {
	encode zstd gzip

	handle /metrics {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# MCP server for AI agents (Authorization: Bearer $MCP_TOKEN)
	handle /mcp {
		reverse_proxy api:3000
	}

	# Members-only pages (#14): no valid session cookie, no page. The API answers
	# 204 (go ahead) or 302 to /login?next=... (returned to the browser as is).
	@members path /inbox /inbox/*
	handle @members {
		root * /srv
		route {
			forward_auth api:3000 {
				uri /api/auth/gate
				header_up X-Forwarded-Uri {http.request.orig_uri}
			}
			try_files {path} /index.html
			file_server
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
